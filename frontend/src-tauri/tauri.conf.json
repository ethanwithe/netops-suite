{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetOps Suite",
  "version": "1.0.0",
  "identifier": "com.netops.suite",
  "build": { "frontendDist": "./splash" },
  "app": {
    "windows": [
      { "label": "main", "title": "NetOps Suite", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "binaries/netops-server.exe": "netops-server.exe" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"] }
    }
  }
}
