# Variables para el BACKEND en Vercel (Project > Settings > Environment Variables).
# NO pongas contraseñas reales en este archivo ni en el repositorio.

DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
REDIS_URL=rediss://default:CLAVE@HOST:PUERTO

# Dirección del frontend (y, si usas varios *.vercel.app, la expresión regular)
CORS_ORIGINS=https://tu-frontend.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Se activa solo en Vercel; fuerza guardar fotos y PDF en la base de datos
# STORAGE_BACKEND=db
# FILE_RETENTION_DAYS=30
